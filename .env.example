PORT=3002
PUBLIC_URL=https://eejctogo.org
DATA_DIR=./data
# Mettre à 1 si le serveur tourne derrière un reverse proxy (nginx, Caddy,
# hébergeur). Sinon toutes les requêtes portent l'IP du proxy : la limitation
# de débit s'applique alors à tout le monde à la fois et ne protège plus.
# Laisser à 0 si Node est exposé directement sur Internet.
TRUST_PROXY=0
ADMIN_PASSWORD=changez-ce-mot-de-passe
SMTP_HOST=votre.serveur-smtp.com
SMTP_PORT=587
SMTP_USER=contact@eej-c.org
SMTP_PASS=votre-mot-de-passe
SMTP_FROM=contact@eej-c.org
CONTACT_TO=eejc2026@gmail.com
